# このファイルを .env にコピーして値を入れる（.env は Git に入れない）
# DB パスワード：長くランダムなものにする
DB_PASSWORD=change-me
# JWT 署名鍵：32バイト以上の乱数を base64 にしたもの。作り方（PowerShell）:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=change-me-base64
# 開発・デモ用ダミーデータ（ユーザー100名・休暇残・出勤記録・申請）。本番では DEV_SEED_ENABLED=false、DEV_SEED_PASSWORD は空欄にする
# 手軽に試したいだけなら、このファイルではなく .env.demo を使う（README 参照）
DEV_SEED_ENABLED=false
DEV_SEED_PASSWORD=
# API ドキュメント（Swagger UI）を公開するか。本番では false（既定）。デモ・開発で見たいときだけ true
API_DOCS_ENABLED=false
# 本番の初回起動用の管理者（ユーザーが0件のときだけ作成）。パスワードは12文字以上・英数字。初回ログイン時に変更を求められる
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# 公開ポート（ブラウザで http://localhost:8081 を開く）
WEB_PORT=8081
