# ============================================================================
# デモ専用の設定。動作確認・ポートフォリオ閲覧のために公開している「使い捨ての値」です。
#   起動:  docker compose --env-file .env.demo up -d --build
#   画面:  http://localhost:8081
# ここに書かれているパスワード・鍵は誰でも見られるため、絶対に本番や公開サーバーで使わないでください。
# 本番では .env.example をコピーして .env を作り、長いランダムな値を設定します。
# ============================================================================
DB_PASSWORD=demo-only-db-password
JWT_SECRET=ZGVtby1vbmx5LWp3dC1zZWNyZXQtZG8tbm90LXVzZS1pbi1wcm9kdWN0aW9uLTAxMjM0NTY3ODlhYmNkZWY=
WEB_PORT=8081

# デモデータ（ユーザー100名・休暇残・直近の出勤記録・状態の異なる申請）を投入する
DEV_SEED_ENABLED=true

# API ドキュメント（Swagger UI）を公開する： http://localhost:8081/swagger-ui.html
API_DOCS_ENABLED=true
DEV_SEED_PASSWORD=Demo-Pass-2026

# デモデータが管理者を作るので、初回管理者は使わない
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
